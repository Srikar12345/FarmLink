{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install && pnpm rebuild esbuild",
  "buildCommand": "cd artifacts/mobile && pnpm exec expo export --platform web",
  "outputDirectory": "artifacts/mobile/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!_expo/|assets/|favicon\\.ico|metadata\\.json).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
